# Required for Telegram Bot API
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Optional: long polling timeout in seconds (default 60)
# TELEGRAM_POLLING_TIMEOUT=30

# Optional: persist offset to file so restart continues from last (avoids re-scanning old updates)
# TELEGRAM_POLL_OFFSET_FILE=helix-bot/.poll_offset

# Optional: mode (polling | webhook); v0.1 uses polling
# TELEGRAM_MODE=polling
